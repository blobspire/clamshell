#!/bin/bash
#
# clamshell — keep a Mac awake with the lid closed, on battery.
#
# macOS only allows true clamshell operation when connected to AC power *and*
# an external display. This lifts that restriction so long-running work (build
# jobs, agents, transfers) survives closing the lid and walking away.
#
# It runs in the FOREGROUND and holds the terminal on purpose. The setting it
# changes (`pmset disablesleep`) is written to disk and survives reboots, so a
# background daemon that silently left it on would be a genuine footgun. While
# this process is visible in a window, you remember to stop it.
#
# Ctrl-C — or closing the terminal, or SIGTERM — restores normal sleep.
#
# Requires: macOS, bash 3.2+ (the system /bin/bash), sudo rights for pmset.
# Contributors: keep this bash 3.2 compatible. No associative arrays, no
# ${var^^}, no mapfile. macOS ships bash 3.2 and always will.
#
# https://github.com/blobspire/clamshell
# MIT licensed.
#
set -uo pipefail

VERSION="1.0.0"

# ------------------------------------------------------------------ config --

INTERVAL=5           # status refresh, seconds
MIN_BATTERY=10       # auto-restore sleep at or below this %; 0 disables
LOG_EVERY=60         # when not a tty, print a line this often (seconds)

LOCKDIR="${TMPDIR:-/tmp}/clamshell-$(id -u).lock"
PM_PLIST="/Library/Preferences/com.apple.PowerManagement.plist"

# ------------------------------------------------------------------ output --

# Only emit ANSI when stdout is a terminal, so `clamshell > run.log` stays
# readable instead of filling with escape codes.
if [ -t 1 ]; then
  IS_TTY=1
  RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'
  DIM=$'\033[2m';  BLD=$'\033[1m';  OFF=$'\033[0m'; CLR=$'\033[K'
else
  IS_TTY=0
  RED=""; GRN=""; YEL=""; DIM=""; BLD=""; OFF=""; CLR=""
fi

die() { printf '%sclamshell: %s%s\n' "$RED" "$*" "$OFF" >&2; exit 1; }

# ------------------------------------------------------------------- state --

CAFFEINATE_PID=""
KEEPALIVE_PID=""
SLEEP_PID=""
PRIOR_DISABLESLEEP=0
SLEEP_WAS_SET=0     # only 1 once WE have actually set disablesleep
HAVE_LOCK=0
CLEANED=0
AUTH_NOTE=""
STOP_REASON=""

sleep_disabled_now() {
  pmset -g | awk '/SleepDisabled/ { print $2; found=1 } END { if (!found) print 0 }'
}

# NOTE: do not pipe into `grep -q` here. With `set -o pipefail`, grep -q exits
# on the first match, SIGPIPEs the producer (exit 141), and pipefail propagates
# that as a pipeline failure — a false negative that depends on how much output
# the producer buffers. Capture first, match with `case`.
has_battery() {
  case "$(pmset -g batt 2>/dev/null)" in
    *InternalBattery*) return 0 ;;
    *) return 1 ;;
  esac
}

battery_pct() { pmset -g batt 2>/dev/null | grep -Eo '[0-9]+%' | head -1 | tr -d '%'; }

# Substring matching, not a regex alternation: `grep -Eo 'charging'` happily
# matches the "charging" inside "not charging" and reports a full battery on
# AC as actively charging. macOS emits more states than the obvious three —
# "finishing charge" and "not charging" both show up on a healthy machine.
battery_state() {
  case "$(pmset -g batt 2>/dev/null)" in
    *"not charging"*)     echo "not charging" ;;
    *"finishing charge"*) echo "finishing charge" ;;
    *"; discharging"*)    echo "discharging" ;;
    *"; charging"*)       echo "charging" ;;
    *"; charged"*)        echo "charged" ;;
    *)                    echo "unknown" ;;
  esac
}

battery_left() {
  pmset -g batt 2>/dev/null | grep -Eo '[0-9]+:[0-9]{2} remaining' | grep -Eo '[0-9]+:[0-9]{2}'
}

# "Yes" means the lid is shut. Desktop Macs have no such key at all.
# ioreg emits a lot of output, so this is exactly where the pipefail/grep -q
# SIGPIPE trap above bites. Capture once, match with `case`.
lid_state() { ioreg -r -k AppleClamshellState -d 4 2>/dev/null; }

lid_closed() {
  case "$(lid_state)" in
    *'"AppleClamshellState" = Yes'*) return 0 ;;
    *) return 1 ;;
  esac
}

lid_supported() {
  case "$(lid_state)" in
    *'"AppleClamshellState"'*) return 0 ;;
    *) return 1 ;;
  esac
}

# -------------------------------------------------------------------- lock --

# mkdir is atomic on every filesystem that matters, which makes it a better
# mutex than test-then-create. Two instances must never both believe they own
# the setting: if one exits it would clear disablesleep while the other is
# still telling you the lid is safe to close.
acquire_lock() {
  if mkdir "$LOCKDIR" 2>/dev/null; then
    echo $$ > "$LOCKDIR/pid"
    HAVE_LOCK=1
    return 0
  fi

  local other=""
  [ -r "$LOCKDIR/pid" ] && other=$(cat "$LOCKDIR/pid" 2>/dev/null)

  if [ -n "$other" ] && kill -0 "$other" 2>/dev/null; then
    return 1
  fi

  # Lock exists but its owner is gone — a previous run was SIGKILLed.
  rm -rf "$LOCKDIR"
  mkdir "$LOCKDIR" 2>/dev/null || return 1
  echo $$ > "$LOCKDIR/pid"
  HAVE_LOCK=1
  return 0
}

running_pid() {
  [ -r "$LOCKDIR/pid" ] || return 1
  local p
  p=$(cat "$LOCKDIR/pid" 2>/dev/null)
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"
}

# ----------------------------------------------------------------- cleanup --

restore_sleep() {
  if sudo -n pmset -a disablesleep 0 2>/dev/null; then
    return 0
  fi
  printf '%s  sudo timestamp expired — authenticate to restore sleep:%s\n' "$YEL" "$OFF"
  sudo pmset -a disablesleep 0
}

cleanup() {
  [ "$CLEANED" -eq 1 ] && return
  CLEANED=1

  [ -n "$SLEEP_PID" ]      && kill "$SLEEP_PID"      2>/dev/null
  [ -n "$KEEPALIVE_PID" ]  && kill "$KEEPALIVE_PID"  2>/dev/null
  [ -n "$CAFFEINATE_PID" ] && kill "$CAFFEINATE_PID" 2>/dev/null

  # Bail out before touching pmset if we never changed it. Otherwise a bad
  # argument or a failed startup check would fire this trap and sit there
  # prompting for authentication to "restore" a setting we never set.
  if [ "$SLEEP_WAS_SET" -eq 0 ]; then
    [ "$HAVE_LOCK" -eq 1 ] && rm -rf "$LOCKDIR"
    return 0
  fi

  printf '\n\n'

  [ -n "$STOP_REASON" ] && printf '%s  %s%s\n' "$YEL" "$STOP_REASON" "$OFF"

  if [ "$PRIOR_DISABLESLEEP" -eq 1 ]; then
    printf '%s  ! disablesleep was already on before this ran — leaving it on.%s\n' "$YEL" "$OFF"
    printf '%s    run "clamshell --off" if that was not intentional.%s\n\n' "$DIM" "$OFF"
  else
    restore_sleep
    if [ "$(sleep_disabled_now)" -eq 0 ]; then
      printf '%s  ✓ normal sleep restored — lid close will sleep again%s\n\n' "$GRN" "$OFF"
    else
      printf '%s  ✗ FAILED to restore sleep. Your Mac will not sleep, even%s\n' "$RED" "$OFF"
      printf '%s    after a reboot. Fix it with:%s\n' "$RED" "$OFF"
      printf '%s      clamshell --off%s\n\n' "$BLD" "$OFF"
      [ "$HAVE_LOCK" -eq 1 ] && rm -rf "$LOCKDIR"
      exit 1
    fi
  fi

  [ "$HAVE_LOCK" -eq 1 ] && rm -rf "$LOCKDIR"
  return 0
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# ------------------------------------------------------------ subcommands ---

usage() {
  cat <<EOF
clamshell $VERSION — keep a Mac awake with the lid closed

USAGE
  clamshell [options]      run in the foreground; Ctrl-C restores sleep
  clamshell --status       show whether sleep is currently disabled
  clamshell --off          restore normal sleep (recovery)

OPTIONS
  --min-battery N   restore sleep and exit at N% battery (default $MIN_BATTERY, 0 = never)
  --interval N      status refresh in seconds (default $INTERVAL)
  -h, --help        this text
  -V, --version     print version

WHY NOT caffeinate
  caffeinate prevents *idle* sleep. It does not prevent lid-close sleep, so it
  silently fails at this job. Only \`pmset disablesleep 1\` works, and it needs
  root. clamshell sets it, holds it while you watch, and clears it on exit.

IMPORTANT
  The setting persists across reboots. If clamshell is SIGKILLed it cannot
  clean up, and your Mac will not sleep until you run \`clamshell --off\`.

AUTHENTICATION
  Needs sudo for pmset. To avoid typing a password every run, either:

  1. Touch ID (recommended — no standing grant):
       sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
       sudo sed -i '' 's/^#auth/auth/' /etc/pam.d/sudo_local
     Does not work inside tmux/screen without pam_reattach.

  2. A scoped sudoers rule (passwordless, but a standing grant):
       $(id -un) ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 1, \\
                 /usr/bin/pmset -a disablesleep 0
     Validate with 'visudo -c -f FILE' BEFORE installing to
     /etc/sudoers.d/clamshell (mode 0440, root:wheel). A malformed file
     there makes sudo refuse to run at all.
EOF
}

cmd_status() {
  local disabled pid
  disabled=$(sleep_disabled_now)
  pid=$(running_pid) || pid=""

  printf '\n  %sclamshell %s%s\n\n' "$BLD" "$VERSION" "$OFF"

  if [ "$disabled" -eq 1 ]; then
    printf '  lid-close sleep : %sDISABLED%s (Mac will not sleep)\n' "$YEL" "$OFF"
  else
    printf '  lid-close sleep : %snormal%s\n' "$GRN" "$OFF"
  fi

  if [ -n "$pid" ]; then
    printf '  running         : yes, pid %s\n' "$pid"
  else
    printf '  running         : no\n'
    if [ "$disabled" -eq 1 ]; then
      printf '  %s! sleep is disabled with nothing holding it — run: clamshell --off%s\n' "$RED" "$OFF"
    fi
  fi

  if lid_supported; then
    if lid_closed; then printf '  lid             : closed\n'
    else                printf '  lid             : open\n'; fi
  else
    printf '  lid             : n/a (no lid on this Mac)\n'
  fi

  if has_battery; then
    printf '  battery         : %s%% %s\n' "$(battery_pct)" "$(battery_state)"
  else
    printf '  battery         : n/a (desktop Mac)\n'
  fi

  # plutil reports this as a boolean ("true"/"false"), not the 0/1 pmset shows.
  local persisted
  persisted=$(plutil -extract SystemPowerSettings.SleepDisabled raw "$PM_PLIST" 2>/dev/null)
  case "$persisted" in
    true|1)  persisted="1 (survives reboot)" ;;
    false|0) persisted="0" ;;
    *)       persisted="not set" ;;
  esac
  printf '  persisted       : %s\n                    %s\n\n' "$persisted" "$PM_PLIST"
}

cmd_off() {
  local pid
  pid=$(running_pid) || pid=""

  if [ -n "$pid" ]; then
    printf '  stopping running clamshell (pid %s)...\n' "$pid"
    kill -TERM "$pid" 2>/dev/null
    local n=0
    while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 20 ]; do
      sleep 0.5; n=$((n + 1))
    done
  fi

  if [ "$(sleep_disabled_now)" -eq 0 ]; then
    printf '%s  ✓ sleep is normal — nothing to do%s\n' "$GRN" "$OFF"
    rm -rf "$LOCKDIR"
    return 0
  fi

  restore_sleep
  rm -rf "$LOCKDIR"

  if [ "$(sleep_disabled_now)" -eq 0 ]; then
    printf '%s  ✓ normal sleep restored%s\n' "$GRN" "$OFF"
  else
    printf '%s  ✗ could not restore. Try: sudo pmset -a disablesleep 0%s\n' "$RED" "$OFF"
    return 1
  fi
}

# ------------------------------------------------------------------- args ---

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)     trap - EXIT; usage; exit 0 ;;
    -V|--version)  trap - EXIT; echo "clamshell $VERSION"; exit 0 ;;
    --status)      trap - EXIT; cmd_status; exit 0 ;;
    --off)         trap - EXIT; cmd_off; exit $? ;;
    --min-battery) [ $# -ge 2 ] || die "--min-battery needs a value"
                   MIN_BATTERY="$2"; shift 2 ;;
    --interval)    [ $# -ge 2 ] || die "--interval needs a value"
                   INTERVAL="$2"; shift 2 ;;
    *)             trap - EXIT; die "unknown option: $1 (try --help)" ;;
  esac
done

case "$MIN_BATTERY" in
  *[!0-9]*|"") die "--min-battery must be a whole number" ;;
  *) ;;
esac
case "$INTERVAL" in
  *[!0-9]*|""|0) die "--interval must be a positive whole number" ;;
  *) ;;
esac

# ------------------------------------------------------------------ start ---

[ "$(uname)" = "Darwin" ] || die "macOS only"
command -v pmset >/dev/null 2>&1 || die "pmset not found"

if ! acquire_lock; then
  trap - EXIT
  die "already running (pid $(cat "$LOCKDIR/pid" 2>/dev/null)) — Ctrl-C that one, or: clamshell --off"
fi

PRIOR_DISABLESLEEP=$(sleep_disabled_now)

printf '\n  %sclamshell%s — keeping this Mac awake with the lid closed\n\n' "$BLD" "$OFF"

if ! lid_supported; then
  printf '  %s! this Mac has no lid — disablesleep still works, but you probably%s\n' "$YEL" "$OFF"
  printf '  %s  want "caffeinate" instead.%s\n\n' "$YEL" "$OFF"
fi

# Try passwordless first. `sudo -n -l CMD` is NOT a valid probe for this: it
# returns 0 for anything you are merely permitted to run, password or not.
# Attempting the real command is the only honest test.
if sudo -n pmset -a disablesleep 1 2>/dev/null; then
  AUTH_NOTE="passwordless via /etc/sudoers.d/clamshell"
else
  sudo -v || die "need sudo to change power settings"
  sudo pmset -a disablesleep 1

  # Keep the timestamp warm so cleanup hours later never stalls on a prompt.
  ( while kill -0 "$$" 2>/dev/null; do sudo -n true 2>/dev/null; sleep 30; done ) &
  KEEPALIVE_PID=$!
  AUTH_NOTE="interactive (Touch ID or password), timestamp kept warm"
fi

# From here on we are responsible for the setting, even if the verify below
# fails — the pmset call has already been issued.
SLEEP_WAS_SET=1

[ "$(sleep_disabled_now)" -eq 1 ] || die "failed to set disablesleep"

# Second layer: caffeinate blocks idle/system/disk sleep. Deliberately no -d,
# so the display still sleeps normally — with the lid shut the panel is off
# anyway, and pinning it on with the lid open would just burn battery.
# -w $$ makes caffeinate exit on its own even if this script is SIGKILLed.
caffeinate -ims -w $$ &
CAFFEINATE_PID=$!

HAS_BATTERY=0
has_battery && HAS_BATTERY=1

START_PCT=0
[ "$HAS_BATTERY" -eq 1 ] && START_PCT=$(battery_pct)
START_TS=$SECONDS

printf '  %s✓%s lid-close sleep disabled    %s(pmset disablesleep 1)%s\n' "$GRN" "$OFF" "$DIM" "$OFF"
printf '  %s✓%s idle/system/disk sleep held %s(caffeinate pid %s)%s\n' "$GRN" "$OFF" "$DIM" "$CAFFEINATE_PID" "$OFF"
printf '  %s✓%s auth: %s%s%s\n' "$GRN" "$OFF" "$DIM" "$AUTH_NOTE" "$OFF"
if [ "$HAS_BATTERY" -eq 1 ] && [ "$MIN_BATTERY" -gt 0 ]; then
  printf '  %s✓%s auto-restores sleep at %s%s%% battery%s\n' \
    "$GRN" "$OFF" "$DIM" "$MIN_BATTERY" "$OFF"
fi
printf '\n  %sPress Ctrl-C to stop and restore normal sleep.%s\n' "$BLD" "$OFF"
printf '  %sLeave this window open — it is the only thing holding the lid awake.%s\n\n' "$DIM" "$OFF"

# ----------------------------------------------------------------- status ---

LAST_LOG=$(( SECONDS - LOG_EVERY ))

while true; do
  elapsed=$(( SECONDS - START_TS ))
  h=$(( elapsed / 3600 )); m=$(( (elapsed % 3600) / 60 )); s=$(( elapsed % 60 ))

  lid="lid open"
  lid_supported && lid_closed && lid="lid closed"

  if [ "$HAS_BATTERY" -eq 1 ]; then
    pct=$(battery_pct); [ -n "$pct" ] || pct=0
    state=$(battery_state)
    left=$(battery_left)

    case "$state" in
      discharging)
        icon="🔋"
        detail=$(printf 'used %d%%' "$(( START_PCT - pct ))")
        [ -n "$left" ] && detail="$detail, ~$left left"
        # Let the Mac sleep cleanly rather than die at 0%. A hard power loss
        # loses whatever the work was; a normal sleep preserves it.
        if [ "$MIN_BATTERY" -gt 0 ] && [ "$pct" -le "$MIN_BATTERY" ]; then
          STOP_REASON="battery hit ${pct}% — restoring sleep so the Mac suspends cleanly"
          break
        fi
        ;;
      charging)      icon="⚡"; detail="charging" ;;
      "not charging") icon="🔌"; detail="on AC, not charging" ;;
      charged)       icon="🔌"; detail="on AC, full" ;;
      *)             icon="🔌"; detail="$state" ;;
    esac
    status_body=$(printf 'battery %s%%   %s · %s' "$pct" "$detail" "$lid")
  else
    icon="🖥️"
    status_body="$lid"
  fi

  if [ "$IS_TTY" -eq 1 ]; then
    printf '\r  %s awake %02d:%02d:%02d   %s%s%s  %s' \
      "$icon" "$h" "$m" "$s" "$DIM" "$status_body" "$OFF" "$CLR"
  elif [ $(( SECONDS - LAST_LOG )) -ge "$LOG_EVERY" ]; then
    printf 'awake %02d:%02d:%02d   %s\n' "$h" "$m" "$s" "$status_body"
    LAST_LOG=$SECONDS
  fi

  # Backgrounded sleep + wait so signals are handled immediately instead of
  # after the current sleep finishes.
  sleep "$INTERVAL" &
  SLEEP_PID=$!
  wait "$SLEEP_PID" 2>/dev/null
  SLEEP_PID=""
done
